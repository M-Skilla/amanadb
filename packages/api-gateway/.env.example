PORT=3000
AMANADB_CHANNEL=mychannel
AMANADB_CHAINCODE=storage

AMANADB_MSP_ID=Org1MSP
AMANADB_CERT_PATH=/absolute/path/to/org1-service@org1.example.com/msp/signcerts/cert.pem
AMANADB_KEY_PATH=/absolute/path/to/org1-service@org1.example.com/msp/keystore/<hash>_sk
AMANADB_PEER_ENDPOINT=localhost:7051
AMANADB_PEER_TLS_CERT_PATH=/absolute/path/to/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
AMANADB_PEER_HOST_ALIAS=peer0.org1.example.com